OPENROUTER_API_KEY=
# Shared passcode for the public link. Empty disables the check (local dev).
APP_PASSCODE=
# Daily spend cap in USD across all sessions; turns fall back to offline mode beyond it.
DAILY_SPEND_CAP_USD=5
MODEL_EVALUATOR=google/gemini-2.5-flash
MODEL_GENERATOR=google/gemini-2.5-flash
MODEL_FALLBACKS=openai/gpt-4.1-mini
MODEL_JUDGE=openai/gpt-4.1
MODEL_STT=openai/whisper-large-v3-turbo
# Measured ~0.8 s per short clip. microsoft/mai-transcribe-2 took 14-26 s; raise this if you use it.
STT_TIMEOUT_MS=10000
MODEL_TTS=google/gemini-3.8-flash-tts
# Voices are model-specific and required by every TTS provider on OpenRouter.
TTS_VOICE=Kore
DB_PATH=./data/tutor.db
PORT=8787
# Lets the debug drawer inject provider faults per request. Keep on for the demo.
ALLOW_FAULT_INJECTION=true
# e.g. llm_timeout:0.3,llm_garbage:0.2,tts_down:1
FAULT_INJECT=
